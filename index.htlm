<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Agenda Oficial FEA 2026</title>
  <!-- Google Fonts & Lucide Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    :root {
      --mep-blue: #002F6C;
      --mep-blue-hover: #001f48;
      --mep-accent: #0284C7;
      --mep-accent-soft: #E0F2FE;
      --bg-light: #F8FAFC;
      --surface: #FFFFFF;
      --text-main: #0F172A;
      --text-muted: #64748B;
      --border-color: #E2E8F0;
      --badge-bg: #F1F5F9;
      --radius: 12px;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
      --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.08), 0 2px 4px -2px rgba(0,0,0,0.05);
      --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-light);
      color: var(--text-main);
      line-height: 1.5;
      padding-bottom: 60px;
    }

    /* HEADER */
    header {
      background: linear-gradient(135deg, var(--mep-blue) 0%, #001A3D 100%);
      color: #ffffff;
      padding: 3.5rem 1.5rem 4rem;
      text-align: center;
      position: relative;
    }

    header h1 {
      font-size: 2.2rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
    }

    header p {
      font-size: 1.1rem;
      color: #94A3B8;
      max-width: 600px;
      margin: 0 auto;
    }

    .badge-year {
      display: inline-block;
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 4px 14px;
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      margin-bottom: 1rem;
      text-transform: uppercase;
    }

    /* MAIN CONTAINER */
    .container {
      max-width: 1200px;
      margin: -2rem auto 0;
      padding: 0 1.25rem;
    }

    /* SEARCH & CONTROLS */
    .controls-card {
      background: var(--surface);
      border-radius: var(--radius);
      padding: 1.25rem;
      box-shadow: var(--shadow-md);
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .search-wrapper {
      position: relative;
      width: 100%;
    }

    .search-wrapper i {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      width: 20px;
      height: 20px;
    }

    .search-input {
      width: 100%;
      padding: 0.85rem 1rem 0.85rem 2.75rem;
      border: 1.5px solid var(--border-color);
      border-radius: 8px;
      font-size: 0.95rem;
      outline: none;
      transition: var(--transition);
    }

    .search-input:focus {
      border-color: var(--mep-accent);
      box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    }

    /* TABS */
    .tabs-days {
      display: flex;
      overflow-x: auto;
      gap: 0.5rem;
      padding-bottom: 4px;
    }

    .tab-btn {
      flex: 1;
      min-width: 170px;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0.85rem 1rem;
      background: #F1F5F9;
      border: 1.5px solid transparent;
      border-radius: 10px;
      cursor: pointer;
      font-family: inherit;
      transition: var(--transition);
    }

    .tab-btn:hover {
      background: #E2E8F0;
    }

    .tab-btn.active {
      background: var(--mep-blue);
      color: #fff;
      border-color: var(--mep-blue);
    }

    .tab-btn .day-title {
      font-weight: 700;
      font-size: 0.95rem;
    }

    .tab-btn .day-sub {
      font-size: 0.8rem;
      opacity: 0.8;
      margin-top: 2px;
    }

    /* STATS & QUICK FILTER */
    .summary-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
      color: var(--text-muted);
      padding: 0 0.5rem;
    }

    /* VENUE BLOCK */
    .venue-card {
      background: var(--surface);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border-color);
      margin-bottom: 2rem;
      overflow: hidden;
    }

    .venue-header {
      background: #F8FAFC;
      border-bottom: 1px solid var(--border-color);
      padding: 1.2rem 1.5rem;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
    }

    .venue-title-group {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .venue-icon-box {
      width: 42px;
      height: 42px;
      border-radius: 8px;
      background: var(--mep-accent-soft);
      color: var(--mep-accent);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .venue-name {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--mep-blue);
    }

    .venue-session {
      font-size: 0.85rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    /* SCHEDULE GRID */
    .events-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
      gap: 1rem;
      padding: 1.5rem;
    }

    /* EVENT CARD */
    .event-item {
      background: #FFFFFF;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 1rem 1.15rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: var(--transition);
      position: relative;
    }

    .event-item:hover {
      border-color: #CBD5E1;
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .event-item::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: var(--mep-blue);
      border-top-left-radius: 10px;
      border-bottom-left-radius: 10px;
    }

    .event-badges {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.65rem;
    }

    .discipline-badge {
      background: #EFF6FF;
      color: #1D4ED8;
      font-weight: 600;
      font-size: 0.72rem;
      padding: 3px 8px;
      border-radius: 6px;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    .circuit-badge {
      background: #F1F5F9;
      color: #475569;
      font-weight: 600;
      font-size: 0.72rem;
      padding: 3px 8px;
      border-radius: 6px;
    }

    .event-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 0.4rem;
      line-height: 1.35;
    }

    .event-school {
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--mep-accent);
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .event-meta {
      border-top: 1px dashed var(--border-color);
      padding-top: 0.65rem;
      font-size: 0.8rem;
      color: var(--text-muted);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .event-meta strong {
      color: var(--text-main);
      font-weight: 600;
    }

    /* EMPTY STATE */
    .no-results {
      text-align: center;
      padding: 4rem 1rem;
      background: var(--surface);
      border-radius: var(--radius);
      border: 1px dashed var(--border-color);
      display: none;
    }

    .no-results i {
      width: 48px;
      height: 48px;
      color: var(--text-muted);
      margin-bottom: 1rem;
    }

    /* FOOTER */
    footer {
      text-align: center;
      margin-top: 3rem;
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    @media (max-width: 640px) {
      header {
        padding: 2.5rem 1rem 3rem;
      }
      header h1 {
        font-size: 1.7rem;
      }
      .events-grid {
        grid-template-columns: 1fr;
        padding: 1rem;
      }
    }
  </style>
</head>
<body>

  <header>
    <div class="badge-year">Festival Estudiantil de las Artes</div>
    <h1>Programación Regional FEA 2026</h1>
    <p>Consulta las presentaciones de las diferentes disciplinas, circuitos y recintos programados.</p>
  </header>

  <main class="container">
    <!-- CONTROLES Y BUSCADOR -->
    <section class="controls-card">
      <div class="search-wrapper">
        <i data-lucide="search"></i>
        <input type="text" id="searchInput" class="search-input" placeholder="Buscar por obra, institución, participante, disciplina o circuito...">
      </div>

      <div class="tabs-days" id="dayTabs">
        <button class="tab-btn active" data-day="day-1">
          <span class="day-title">Lunes 28 Set</span>
          <span class="day-sub">Coreografías</span>
        </button>
        <button class="tab-btn" data-day="day-2">
          <span class="day-title">Martes 29 Set</span>
          <span class="day-sub">Música Primaria</span>
        </button>
        <button class="tab-btn" data-day="day-3">
          <span class="day-title">Miércoles 30 Set</span>
          <span class="day-sub">Música Secundaria / Noct.</span>
        </button>
        <button class="tab-btn" data-day="day-4">
          <span class="day-title">Jueves 01 Oct</span>
          <span class="day-sub">Escénicas & Visuales</span>
        </button>
        <button class="tab-btn" data-day="day-5">
          <span class="day-title">Viernes 02 Oct</span>
          <span class="day-sub">Artes Literarias</span>
        </button>
      </div>
    </section>

    <!-- ESTADÍSTICAS RÁPIDAS -->
    <div class="summary-bar">
      <span id="resultsCount">Cargando presentaciones...</span>
      <span id="activeFilterBadge">Mostrando: Todos los recintos</span>
    </div>

    <!-- CONTENEDOR DE PROGRAMAS POR DÍA -->
    <div id="scheduleContainer"></div>

    <!-- MENSAJE VACÍO -->
    <div class="no-results" id="emptyState">
      <i data-lucide="folder-search"></i>
      <h3>No se encontraron presentaciones</h3>
      <p>Intenta con otra palabra clave o revisa los filtros aplicados.</p>
    </div>
  </main>

  <footer>
    <p>Dirección Regional de Educación • Ministerio de Educación Pública (MEP)</p>
  </footer>

