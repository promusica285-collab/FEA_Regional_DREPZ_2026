              { discipline: "Microrrelato Digital", circuit: "01", title: "El precio de la educación (pendiente)", school: "Liceo Sinaí", participants: "Génesis Dalissa Valverde Valverde" },
              { discipline: "Microrrelato Digital", circuit: "05", title: "Una promesa bajo las estrellas", school: "CTP General Viejo", participants: "Kiara Arce Ampie" },
              { discipline: "Novela Gráfica", circuit: "09", title: "Ese era el día de mi ejecución", school: "Liceo San Pedro", participants: "Edgardo Alonso Salazar Fonseca" },
              { discipline: "Cuento (Nocturna)", circuit: "03", title: "Sueños rotos", school: "Colegio Nocturno Palmares", participants: "Keilyn Mora Badilla" },
              { discipline: "Cuento (Nocturna)", circuit: "01", title: "El silencio que cantaba", school: "Liceo Nocturno Sinaí", participants: "Luis Fabián Quirós Cordero" },
              { discipline: "Cuento (Nocturna)", circuit: "08", title: "En la mente de Ana", school: "CINDEA Pejibaye", participants: "Kimberly Chanto" },
              { discipline: "Poesía (Nocturna)", circuit: "03", title: "De pie aunque tiemble", school: "CINDEA Lomas de Cocorí", participants: "Wendy Chacón Elizondo" },
              { discipline: "Poesía (Nocturna)", circuit: "01", title: "El silencio de jazz: un alma sin curar", school: "Liceo Académico Nocturno Sinaí", participants: "Jazmín Monge Navarro" },
              { discipline: "Poesía (Nocturna)", circuit: "09", title: "Aires de vuelta", school: "CINDEA San Pedro", participants: "Anthony Valverde Barrantes" },
              { discipline: "Poesía (Nocturna)", circuit: "08", title: "Lo que fuimos, lo que somos y lo que seremos", school: "CINDEA Pejibaye", participants: "Rosa Mora Agüero" },
              { discipline: "Novela Gráfica (Nocturna)", circuit: "03", title: "Estela de Luz", school: "CINDEA Lomas de Cocorí", participants: "Daniela Hernández Atencio" }
            ]
          }
        ]
      }
    ];

    let currentDayId = "day-1";
    const scheduleContainer = document.getElementById("scheduleContainer");
    const searchInput = document.getElementById("searchInput");
    const tabButtons = document.querySelectorAll(".tab-btn");
    const resultsCountEl = document.getElementById("resultsCount");
    const emptyStateEl = document.getElementById("emptyState");

    function renderSchedule() {
      const searchTerm = searchInput.value.trim().toLowerCase();
      scheduleContainer.innerHTML = "";
      let totalVisible = 0;

      scheduleData.forEach(day => {
        const dayMatch = (searchTerm === "") ? (day.id === currentDayId) : true;
        if (!dayMatch) return;

        let dayHasVisibleCards = false;

        day.venues.forEach(venue => {
          const filteredEvents = venue.events.filter(ev => {
            if (!searchTerm) return true;
            return (
              ev.title.toLowerCase().includes(searchTerm) ||
              ev.school.toLowerCase().includes(searchTerm) ||
              ev.discipline.toLowerCase().includes(searchTerm) ||
              ev.participants.toLowerCase().includes(searchTerm) ||
              ev.circuit.includes(searchTerm)
            );
          });

          if (filteredEvents.length > 0) {
            dayHasVisibleCards = true;
            totalVisible += filteredEvents.length;

            const venueCard = document.createElement("section");
            venueCard.className = "venue-card";

            venueCard.innerHTML = `
              <div class="venue-header">
                <div class="venue-title-group">
                  <div class="venue-icon-box">
                    <i data-lucide="map-pin"></i>
                  </div>
                  <div>
                    <h2 class="venue-name">${venue.name}</h2>
                    <p class="venue-session">${day.name} • ${venue.session}</p>
                  </div>
                </div>
                <span class="circuit-badge">${filteredEvents.length} participante(s)</span>
              </div>
              <div class="events-grid">
                ${filteredEvents.map(ev => `
                  <article class="event-item">
                    <div>
                      <div class="event-badges">
                        <span class="discipline-badge">${ev.discipline}</span>
                        <span class="circuit-badge">Circuito ${ev.circuit}</span>
                      </div>
                      <h3 class="event-title">“${ev.title}”</h3>
                      <p class="event-school">
                        <i data-lucide="graduation-cap" style="width:16px;height:16px;"></i>
                        ${ev.school}
                      </p>
                    </div>
                    <div class="event-meta">
                      <span>Participante(s):</span>
                      <strong>${ev.participants}</strong>
                    </div>
                  </article>
                `).join('')}
              </div>
            `;
            scheduleContainer.appendChild(venueCard);
          }
        });
      });

      // Contador e iconos
      resultsCountEl.textContent = `${totalVisible} presentación(es) encontrada(s)`;
      emptyStateEl.style.display = totalVisible === 0 ? "block" : "none";
      lucide.createIcons();
    }

    // EVENTOS DE PESTAÑAS
    tabButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        tabButtons.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        currentDayId = btn.getAttribute("data-day");
        searchInput.value = ""; // Limpiar búsqueda para ver el día limpio
        renderSchedule();
      });
    });

    // EVENTO DE BÚSQUEDA
    searchInput.addEventListener("input", () => {
      renderSchedule();
    });

    // Inicializar
    renderSchedule();
  </script>
</body>
</html>
