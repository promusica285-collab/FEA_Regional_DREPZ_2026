          {
            name: "Auditorio CTP San Isidro",
            session: "12:00 m.d. • Secundaria & Nocturnas",
            events: [
              { discipline: "Cuento", circuit: "03", title: "Jardín de Cenizas", school: "Centro Educativo BMS", participants: "Keylor Mateo Duarte Delgado" },
